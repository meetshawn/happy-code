{
  "name": "happy-code-tui",
  "version": "0.1.0",
  "description": "A coding-focused TUI that works with any OpenAI-compatible API",
  "type": "module",
  "bin": {
    "happycode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:agents": "tsx --test test/agents/**/*.test.ts",
    "prepublish:check": "npm run check && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run prepublish:check"
  },
  "keywords": [
    "tui",
    "coding-agent",
    "openai-compatible",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "clipboardy": "^4.0.0",
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^6.6.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/node": "^22.17.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
